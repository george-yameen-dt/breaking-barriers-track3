   "drop": {
    "title": "Phones without service",
    "type": "data",
    "query": "timeseries series = avg(log.viavi_twin.network.phones_without_service), interval:1m, from:now()-30m\n| fieldsAdd now = arrayLast(arrayRemoveNulls(series))",
    "visualization": "singleValue",
