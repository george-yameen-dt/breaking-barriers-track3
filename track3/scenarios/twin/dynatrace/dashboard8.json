{
 "id": "31c9ec07-ddc0-416c-ab6f-59376a129ff9",
 "name": "Viavi twin (team04): 8-minute test",
 "type": "dashboard",
 "content": {
  "version": 21,
  "variables": [],
  "tiles": {
   "hdr": {
    "type": "markdown",
    "content": "## Viavi twin · 8-minute test\nMinutes 1–3 **healthy**, minutes 4–8 **S3 has lost power** (it can't be switched back on remotely). One point per minute. Run it with `scenarios/twin/run8.py`."
   },
   "cov": {
    "title": "Coverage now",
    "type": "data",
    "query": "timeseries series = avg(log.viavi_twin.network.coverage_pct), interval:1m, from:now()-30m\n| fieldsAdd now = arrayLast(arrayRemoveNulls(series))",
    "visualization": "singleValue",
    "visualizationSettings": {
     "autoSelectVisualization": false,
     "singleValue": {
      "label": "% of phones with signal",
      "recordField": "now",
      "colorThresholdTarget": "background",
      "sparklineSettings": {
       "isVisible": true,
       "record": "series"
      },
      "trend": {
       "isVisible": false
      }
     },
     "thresholds": [
      {
       "id": 1,
       "field": "now",
       "title": "",
       "isEnabled": true,
       "rules": [
        {
         "id": 0,
         "color": {
          "Default": "var(--dt-colors-charts-status-critical-default, #c62239)"
         },
         "comparator": "≥",
         "label": "",
         "value": 0
        },
        {
         "id": 1,
         "color": {
          "Default": "var(--dt-colors-charts-status-warning-default, #eea53c)"
         },
         "comparator": "≥",
         "label": "",
         "value": 70
        },
        {
         "id": 2,
         "color": {
          "Default": "var(--dt-colors-charts-status-ideal-default, #2f6862)"
         },
         "comparator": "≥",
         "label": "",
         "value": 75
        }
       ]
      }
     ]
    },
    "querySettings": {
     "defaultSamplingRatio": 1,
     "defaultScanLimitGbytes": -1,
     "enableSampling": false,
     "maxResultMegaBytes": 20,
     "maxResultRecords": 1000
    }
   },
   "qos": {
    "title": "Network QoS now",
    "type": "data",
