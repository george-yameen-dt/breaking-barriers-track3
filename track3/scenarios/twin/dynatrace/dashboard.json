 "name": "Viavi twin (team04): towers, problems, agent fixes",
 "type": "dashboard",
 "content": {
  "version": 21,
  "variables": [],
  "tiles": {
   "hdr": {
    "type": "markdown",
    "content": "## Viavi twin (team04) · live network\nHealthy = **QoS 100** on every tower (every phone gets the speed it asked for). A tower goes down → Dynatrace opens a problem on it → the agents propose a fix → a person approves → the twin measures the result."
   },
   "qS1": {
    "title": "Tower S1",
    "type": "data",
    "query": "timeseries series = avg(log.viavi_twin.qos_score), filter: twin.cell_name == \"Tower S1\", interval:1m, from:now()-30m\n| fieldsAdd now = arrayLast(arrayRemoveNulls(series))",
    "visualization": "singleValue",
    "visualizationSettings": {
     "autoSelectVisualization": false,
     "singleValue": {
      "label": "QoS now",
      "recordField": "now",
      "colorThresholdTarget": "background",
      "sparklineSettings": {
       "isVisible": true,
       "record": "series"
      },
      "trend": {
       "isVisible": false
      }
     },
     "thresholds": [
      {
       "id": 1,
       "field": "now",
       "title": "",
       "isEnabled": true,
       "rules": [
        {
         "id": 0,
         "color": {
          "Default": "var(--dt-colors-charts-status-critical-default, #c62239)"
         },
         "comparator": "≥",
         "label": "",
         "value": 0
        },
        {
         "id": 1,
         "color": {
          "Default": "var(--dt-colors-charts-status-warning-default, #eea53c)"
         },
         "comparator": "≥",
         "label": "",
         "value": 60
        },
        {
         "id": 2,
         "color": {
          "Default": "var(--dt-colors-charts-status-ideal-default, #2f6862)"
         },
         "comparator": "≥",
         "label": "",
         "value": 90
        }
       ]
      }
     ]
    },
    "querySettings": {
     "defaultSamplingRatio": 1,
     "defaultScanLimitGbytes": -1,
     "enableSampling": false,
     "maxResultMegaBytes": 20,
     "maxResultRecords": 1000
    }
   },
