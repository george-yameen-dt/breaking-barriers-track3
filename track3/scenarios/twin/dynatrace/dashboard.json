   "pwr": {
    "title": "Transmit power (dBm): the agents' lever",
    "type": "data",
    "query": "timeseries value = avg(log.viavi_twin.tx_power_dbm), by:{twin.cell_name}, interval:1m",
    "visualization": "lineChart",
    "visualizationSettings": {
     "autoSelectVisualization": false
    },
    "querySettings": {
     "defaultSamplingRatio": 1,
