    }
   },
   "prob": {
    "title": "Problems",
    "type": "data",
    "query": "fetch dt.davis.problems, from:now()-2h | filter contains(event.name, \"Viavi twin\")\n| dedup display_id, sort:{timestamp desc}\n| fields started = event.start, problem = display_id, status = event.status, what = event.name\n| sort started desc | limit 6",
    "visualization": "table",
    "visualizationSettings": {
     "autoSelectVisualization": false
    },
    "querySettings": {
     "defaultSamplingRatio": 1,
     "defaultScanLimitGbytes": -1,
     "enableSampling": false,
     "maxResultMegaBytes": 20,
     "maxResultRecords": 1000
    }
   },
   "chg": {
    "title": "Agents' changes (approved by a person, checked by Cedar)",
    "type": "data",
    "query": "fetch logs, from:now()-2h | filter service.name == \"viavi-twin\" and twin.kind == \"change\"\n| fields time = timestamp, tower = twin.cell, setting = twin.parameter, from = twin.old_value, to = twin.new_value, accepted = twin.accepted\n| sort time desc | limit 6",
    "visualization": "table",
    "visualizationSettings": {
     "autoSelectVisualization": false
    },
    "querySettings": {
     "defaultSamplingRatio": 1,
     "defaultScanLimitGbytes": -1,
     "enableSampling": false,
     "maxResultMegaBytes": 20,
     "maxResultRecords": 1000
    }
   },
   "logs": {
    "title": "Tower logs (tagged with the tower in Smartscape)",
    "type": "data",
    "query": "fetch logs, from:now()-30m | filter service.name == \"viavi-twin\" and isNotNull(dt.smartscape_source.id)\n| filter isNull(twin.heartbeat)\n| fields timestamp, loglevel, tower = twin.cell_name, content\n| sort timestamp desc | limit 30",
    "visualization": "table",
    "visualizationSettings": {
     "autoSelectVisualization": false
    },
    "querySettings": {
     "defaultSamplingRatio": 1,
     "defaultScanLimitGbytes": -1,
     "enableSampling": false,
     "maxResultMegaBytes": 20,
     "maxResultRecords": 1000
    }
   }
