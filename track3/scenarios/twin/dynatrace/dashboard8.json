     "defaultScanLimitGbytes": -1,
     "enableSampling": false,
     "maxResultMegaBytes": 20,
     "maxResultRecords": 1000
    }
   },
   "phase": {
    "title": "Phase now",
    "type": "data",
    "query": "fetch logs, from:now()-15m | filter service.name == \"viavi-twin\" and isNotNull(twin.phase) and twin.kind == \"network\"\n| sort timestamp desc | limit 1 | fields phase = twin.phase, minute = twin.minute, run = twin.run_id",
    "visualization": "table",
    "visualizationSettings": {
     "autoSelectVisualization": false
    },
    "querySettings": {
     "defaultSamplingRatio": 1,
     "defaultScanLimitGbytes": -1,
     "enableSampling": false,
     "maxResultMegaBytes": 20,
     "maxResultRecords": 1000
    }
   },
   "covl": {
    "title": "Coverage % (healthy, then the power cut)",
    "type": "data",
    "query": "timeseries coverage = avg(log.viavi_twin.network.coverage_pct), interval:1m",
    "visualization": "lineChart",
    "visualizationSettings": {
     "autoSelectVisualization": false
    },
    "querySettings": {
     "defaultSamplingRatio": 1,
     "defaultScanLimitGbytes": -1,
     "enableSampling": false,
     "maxResultMegaBytes": 20,
     "maxResultRecords": 1000
    }
   },
   "qosl": {
    "title": "QoS Score by tower",
    "type": "data",
    "query": "timeseries value = avg(log.viavi_twin.qos_score), by:{twin.cell_name}, interval:1m",
    "visualization": "lineChart",
    "visualizationSettings": {
     "autoSelectVisualization": false
    },
    "querySettings": {
     "defaultSamplingRatio": 1,
     "defaultScanLimitGbytes": -1,
     "enableSampling": false,
     "maxResultMegaBytes": 20,
     "maxResultRecords": 1000
    }
   },
   "load": {
    "title": "Tower load %",
    "type": "data",
    "query": "timeseries value = avg(log.viavi_twin.load_pct), by:{twin.cell_name}, interval:1m",
    "visualization": "lineChart",
    "visualizationSettings": {
     "autoSelectVisualization": false
    },
    "querySettings": {
     "defaultSamplingRatio": 1,
     "defaultScanLimitGbytes": -1,
     "enableSampling": false,
     "maxResultMegaBytes": 20,
     "maxResultRecords": 1000
    }
   },
   "ph": {
    "title": "Phones per tower (S3's phones move to its neighbours)",
    "type": "data",
    "query": "timeseries value = avg(log.viavi_twin.phones), by:{twin.cell_name}, interval:1m",
    "visualization": "lineChart",
    "visualizationSettings": {
     "autoSelectVisualization": false
    },
    "querySettings": {
     "defaultSamplingRatio": 1,
     "defaultScanLimitGbytes": -1,
     "enableSampling": false,
     "maxResultMegaBytes": 20,
     "maxResultRecords": 1000
    }
   },
   "min": {
    "title": "Minute by minute",
    "type": "data",
    "query": "fetch logs, from:now()-30m | filter service.name == \"viavi-twin\" and isNotNull(twin.phase) and twin.kind == \"network\" and isNull(twin.heartbeat)\n| fields minute = twin.minute, phase = twin.phase, `coverage %` = twin.coverage_pct, `without service` = twin.phones_without_service, qos = twin.qos_score, dark = twin.dark_cells\n| sort minute asc | limit 20",
    "visualization": "table",
    "visualizationSettings": {
     "autoSelectVisualization": false
    },
    "querySettings": {
     "defaultSamplingRatio": 1,
     "defaultScanLimitGbytes": -1,
     "enableSampling": false,
     "maxResultMegaBytes": 20,
     "maxResultRecords": 1000
    }
   },
   "ev": {
    "title": "Twin events (fault raised, tower off, lost links)",
    "type": "data",
    "query": "fetch logs, from:now()-30m | filter service.name == \"viavi-twin\" and isNotNull(twin.phase) and twin.kind == \"event\"\n| fields minute = twin.minute, tower = twin.cell_name, event = twin.event_type, content\n| sort minute asc | limit 30",
    "visualization": "table",
    "visualizationSettings": {
     "autoSelectVisualization": false
    },
    "querySettings": {
     "defaultSamplingRatio": 1,
     "defaultScanLimitGbytes": -1,
     "enableSampling": false,
     "maxResultMegaBytes": 20,
     "maxResultRecords": 1000
    }
   },
   "prob": {
    "title": "Problems",
    "type": "data",
    "query": "fetch dt.davis.problems, from:now()-2h | filter contains(event.name, \"Viavi twin\")\n| dedup display_id, sort:{timestamp desc}\n| fields started = event.start, problem = display_id, status = event.status, what = event.name\n| sort started desc | limit 5",
    "visualization": "table",
    "visualizationSettings": {
     "autoSelectVisualization": false
    },
    "querySettings": {
     "defaultSamplingRatio": 1,
     "defaultScanLimitGbytes": -1,
     "enableSampling": false,
     "maxResultMegaBytes": 20,
     "maxResultRecords": 1000
    }
   }
