{
  "customId": "gy-viavi-twin",
  "displayName": "Viavi twin (team04)",
  "metadataList": [],
  "costAllocation": {
    "processors": []
  },
  "dataExtraction": {
    "processors": []
  },
  "metricExtraction": {
    "processors": [
      {
        "description": "Cell QoS Score",
        "enabled": true,
        "id": "gy_twin_m_qos",
        "matcher": "matchesValue(twin.kind, \"cell\")",
        "type": "valueMetric",
        "valueMetric": {
          "dimensions": [
            {
              "extractionType": "field",
              "sourceFieldName": "twin.cell_name"
            },
            {
              "extractionType": "field",
              "sourceFieldName": "twin.network_name"
            },
            {
              "destinationFieldName": "dt.smartscape_source.id",
              "extractionType": "field",
              "sourceFieldName": "dt.smartscape_source.id"
            },
            {
              "extractionType": "field",
              "sourceFieldName": "twin.cell_full"
            },
            {
              "extractionType": "field",
              "sourceFieldName": "twin.criticality"
            }
          ],
          "field": "twin.qos_score",
          "metricKey": "log.viavi_twin.qos_score"
        }
      },
      {
        "description": "Cell load %",
        "enabled": true,
        "id": "gy_twin_m_load",
        "matcher": "matchesValue(twin.kind, \"cell\")",
        "type": "valueMetric",
        "valueMetric": {
          "dimensions": [
            {
              "extractionType": "field",
              "sourceFieldName": "twin.cell_name"
            },
            {
              "extractionType": "field",
              "sourceFieldName": "twin.network_name"
            },
            {
              "destinationFieldName": "dt.smartscape_source.id",
              "extractionType": "field",
              "sourceFieldName": "dt.smartscape_source.id"
            },
            {
              "extractionType": "field",
              "sourceFieldName": "twin.cell_full"
            },
            {
              "extractionType": "field",
              "sourceFieldName": "twin.criticality"
            }
          ],
          "field": "twin.load_pct",
          "metricKey": "log.viavi_twin.load_pct"
        }
      },
      {
        "description": "Phones on the tower",
        "enabled": true,
        "id": "gy_twin_m_phones",
        "matcher": "matchesValue(twin.kind, \"cell\")",
        "type": "valueMetric",
        "valueMetric": {
          "dimensions": [
            {
              "extractionType": "field",
              "sourceFieldName": "twin.cell_name"
            },
            {
              "extractionType": "field",
              "sourceFieldName": "twin.network_name"
            },
            {
              "destinationFieldName": "dt.smartscape_source.id",
              "extractionType": "field",
              "sourceFieldName": "dt.smartscape_source.id"
            },
            {
              "extractionType": "field",
              "sourceFieldName": "twin.cell_full"
            },
            {
              "extractionType": "field",
              "sourceFieldName": "twin.criticality"
            }
          ],
          "field": "twin.active_users",
          "metricKey": "log.viavi_twin.phones"
        }
      },
      {
        "description": "Phones without service near the tower",
        "enabled": true,
        "id": "gy_twin_m_dropped",
        "matcher": "matchesValue(twin.kind, \"cell\")",
        "type": "valueMetric",
        "valueMetric": {
          "dimensions": [
            {
              "extractionType": "field",
              "sourceFieldName": "twin.cell_name"
            },
            {
              "extractionType": "field",
              "sourceFieldName": "twin.network_name"
            },
            {
              "destinationFieldName": "dt.smartscape_source.id",
              "extractionType": "field",
              "sourceFieldName": "dt.smartscape_source.id"
            },
            {
              "extractionType": "field",
              "sourceFieldName": "twin.cell_full"
            },
            {
              "extractionType": "field",
              "sourceFieldName": "twin.criticality"
            }
          ],
          "field": "twin.dropped_nearby",
          "metricKey": "log.viavi_twin.phones_without_service"
        }
      },
      {
        "description": "Cell transmit power",
        "enabled": true,
        "id": "gy_twin_m_power",
        "matcher": "matchesValue(twin.kind, \"cell\")",
        "type": "valueMetric",
        "valueMetric": {
          "dimensions": [
            {
              "extractionType": "field",
              "sourceFieldName": "twin.cell_name"
            },
            {
              "extractionType": "field",
              "sourceFieldName": "twin.network_name"
            },
            {
              "destinationFieldName": "dt.smartscape_source.id",
              "extractionType": "field",
              "sourceFieldName": "dt.smartscape_source.id"
            },
            {
              "extractionType": "field",
              "sourceFieldName": "twin.cell_full"
            },
            {
              "extractionType": "field",
              "sourceFieldName": "twin.criticality"
            }
          ],
          "field": "twin.tx_power_dbm",
          "metricKey": "log.viavi_twin.tx_power_dbm"
        }
      },
      {
        "description": "Cell transmitting (1) or dark (0)",
        "enabled": true,
        "id": "gy_twin_m_enabled",
        "matcher": "matchesValue(twin.kind, \"cell\")",
        "type": "valueMetric",
        "valueMetric": {
          "dimensions": [
            {
              "extractionType": "field",
              "sourceFieldName": "twin.cell_name"
            },
            {
              "extractionType": "field",
              "sourceFieldName": "twin.network_name"
            },
            {
              "destinationFieldName": "dt.smartscape_source.id",
              "extractionType": "field",
              "sourceFieldName": "dt.smartscape_source.id"
            },
            {
              "extractionType": "field",
              "sourceFieldName": "twin.cell_full"
            },
            {
              "extractionType": "field",
              "sourceFieldName": "twin.criticality"
            }
          ],
          "field": "twin.enabled",
          "metricKey": "log.viavi_twin.enabled"
        }
      },
      {
        "description": "Weakest tenth signal (RSRP p10)",
        "enabled": true,
        "id": "gy_twin_m_rsrp",
        "matcher": "matchesValue(twin.kind, \"cell\")",
        "type": "valueMetric",
        "valueMetric": {
          "dimensions": [
            {
              "extractionType": "field",
              "sourceFieldName": "twin.cell_name"
            },
            {
              "extractionType": "field",
              "sourceFieldName": "twin.network_name"
            },
            {
              "destinationFieldName": "dt.smartscape_source.id",
              "extractionType": "field",
              "sourceFieldName": "dt.smartscape_source.id"
            },
            {
              "extractionType": "field",
              "sourceFieldName": "twin.cell_full"
            },
            {
              "extractionType": "field",
              "sourceFieldName": "twin.criticality"
            }
          ],
          "field": "twin.rsrp_dbm_p10",
          "metricKey": "log.viavi_twin.rsrp_p10_dbm"
        }
      },
      {
        "description": "Network QoS Score",
        "enabled": true,
        "id": "gy_twin_m_net_qos",
        "matcher": "matchesValue(twin.kind, \"network\")",
        "type": "valueMetric",
        "valueMetric": {
          "dimensions": [
            {
              "extractionType": "field",
              "sourceFieldName": "twin.network_name"
            },
            {
              "destinationFieldName": "dt.smartscape_source.id",
              "extractionType": "field",
              "sourceFieldName": "dt.smartscape.cell_network"
            }
          ],
          "field": "twin.qos_score",
          "metricKey": "log.viavi_twin.network.qos_score"
        }
      },
      {
        "description": "Network phones without service",
        "enabled": true,
        "id": "gy_twin_m_net_dropped",
        "matcher": "matchesValue(twin.kind, \"network\")",
        "type": "valueMetric",
        "valueMetric": {
          "dimensions": [
            {
              "extractionType": "field",
              "sourceFieldName": "twin.network_name"
            },
            {
              "destinationFieldName": "dt.smartscape_source.id",
              "extractionType": "field",
              "sourceFieldName": "dt.smartscape.cell_network"
            }
          ],
          "field": "twin.phones_without_service",
          "metricKey": "log.viavi_twin.network.phones_without_service"
        }
      },
      {
        "description": "Network coverage % (RSRP > -110 dBm)",
        "enabled": true,
        "id": "gy_twin_m_net_cov",
        "matcher": "matchesValue(twin.kind, \"network\")",
        "type": "valueMetric",
        "valueMetric": {
          "dimensions": [
            {
              "extractionType": "field",
              "sourceFieldName": "twin.network_name"
            },
            {
              "destinationFieldName": "dt.smartscape_source.id",
              "extractionType": "field",
              "sourceFieldName": "dt.smartscape.cell_network"
            }
          ],
          "field": "twin.coverage_pct",
          "metricKey": "log.viavi_twin.network.coverage_pct"
        }
      }
    ]
  },
  "processing": {
    "processors": []
  },
  "productAllocation": {
    "processors": []
  },
  "securityContext": {
    "processors": []
  },
  "storage": {
    "processors": []
  },
  "smartscapeEdgeExtraction": {
    "processors": []
  },
  "smartscapeNodeExtraction": {
    "processors": [
      {
        "description": "Viavi twin network",
        "enabled": true,
        "id": "gy_twin_network_node",
        "type": "smartscapeNode",
        "matcher": "isNotNull(twin.network)",
        "smartscapeNode": {
          "extractNode": true,
          "fieldsToExtract": [],
          "idComponents": [
            {
              "idComponent": "network",
              "referencedFieldName": "twin.network"
            }
          ],
          "nodeIdFieldName": "dt.smartscape.cell_network",
          "nodeName": {
            "type": "field",
            "field": {
              "sourceFieldName": "twin.network_name"
            }
          },
          "nodeType": "CUSTOM_CELL_NETWORK",
          "staticEdgesToExtract": []
        }
      },
      {
        "description": "Viavi twin towers (sites)",
        "enabled": true,
        "id": "gy_twin_tower_node",
        "type": "smartscapeNode",
        "matcher": "matchesValue(twin.kind, \"cell\") and isNotNull(twin.site)",
        "smartscapeNode": {
          "extractNode": true,
          "fieldsToExtract": [
            {
              "fieldName": "twin.criticality",
              "referencedFieldName": "twin.criticality"
            }
          ],
          "idComponents": [
            {
              "idComponent": "network",
              "referencedFieldName": "twin.network"
            },
            {
              "idComponent": "tower",
              "referencedFieldName": "twin.site"
            }
          ],
          "nodeIdFieldName": "dt.smartscape.cell_tower",
          "nodeName": {
            "type": "field",
            "field": {
              "sourceFieldName": "twin.cell_name"
            }
          },
          "nodeType": "CUSTOM_CELL_TOWER",
          "staticEdgesToExtract": [
            {
              "edgeType": "belongs_to",
              "targetIdFieldName": "dt.smartscape.cell_network",
              "targetType": "CUSTOM_CELL_NETWORK"
            }
          ]
        }
      },
      {
        "description": "Viavi twin cells",
        "enabled": true,
        "id": "gy_twin_cell_node",
        "type": "smartscapeNode",
        "matcher": "matchesValue(twin.kind, \"cell\")",
        "smartscapeNode": {
          "extractNode": true,
          "fieldsToExtract": [
            {
              "fieldName": "twin.state",
              "referencedFieldName": "twin.state"
            },
            {
              "fieldName": "twin.tx_power_dbm",
              "referencedFieldName": "twin.tx_power_dbm"
            },
            {
              "fieldName": "twin.tilt_deg",
              "referencedFieldName": "twin.tilt_deg"
            },
            {
              "fieldName": "twin.active_users",
              "referencedFieldName": "twin.active_users"
            },
            {
              "fieldName": "twin.dropped_nearby",
              "referencedFieldName": "twin.dropped_nearby"
            },
            {
              "fieldName": "twin.criticality",
              "referencedFieldName": "twin.criticality"
            },
            {
              "fieldName": "twin.band",
              "referencedFieldName": "twin.band"
            },
            {
              "fieldName": "twin.pci",
              "referencedFieldName": "twin.pci"
            },
            {
              "fieldName": "twin.frequency",
              "referencedFieldName": "twin.frequency"
            },
            {
              "fieldName": "twin.nrcgi",
              "referencedFieldName": "twin.nrcgi"
            }
          ],
          "idComponents": [
            {
              "idComponent": "network",
              "referencedFieldName": "twin.network"
            },
            {
              "idComponent": "cell",
              "referencedFieldName": "twin.cell"
            }
          ],
          "nodeIdFieldName": "dt.smartscape_source.id",
          "nodeName": {
            "type": "field",
            "field": {
              "sourceFieldName": "twin.cell_full"
            }
          },
          "nodeType": "CUSTOM_CELL",
          "staticEdgesToExtract": [
            {
              "edgeType": "belongs_to",
              "targetIdFieldName": "dt.smartscape.cell_tower",
              "targetType": "CUSTOM_CELL_TOWER"
            },
            {
              "edgeType": "connects_to",
              "targetIdFieldName": "dt.smartscape.neighbor_1",
              "targetType": "CUSTOM_CELL"
            },
            {
              "edgeType": "connects_to",
              "targetIdFieldName": "dt.smartscape.neighbor_2",
              "targetType": "CUSTOM_CELL"
            },
            {
              "edgeType": "connects_to",
              "targetIdFieldName": "dt.smartscape.neighbor_3",
              "targetType": "CUSTOM_CELL"
            }
          ]
        }
      },
      {
        "description": "Neighbour cell 1 (id only)",
        "enabled": true,
        "id": "gy_twin_neighbor_1",
        "type": "smartscapeNode",
        "matcher": "matchesValue(twin.kind, \"cell\") and isNotNull(twin.neighbor_1)",
        "smartscapeNode": {
          "extractNode": false,
          "idComponents": [
            {
              "idComponent": "network",
              "referencedFieldName": "twin.network"
            },
            {
              "idComponent": "cell",
              "referencedFieldName": "twin.neighbor_1"
            }
          ],
          "nodeIdFieldName": "dt.smartscape.neighbor_1",
          "nodeType": "CUSTOM_CELL"
        }
      },
      {
        "description": "Neighbour cell 2 (id only)",
        "enabled": true,
        "id": "gy_twin_neighbor_2",
        "type": "smartscapeNode",
        "matcher": "matchesValue(twin.kind, \"cell\") and isNotNull(twin.neighbor_2)",
        "smartscapeNode": {
          "extractNode": false,
          "idComponents": [
            {
              "idComponent": "network",
              "referencedFieldName": "twin.network"
            },
            {
              "idComponent": "cell",
              "referencedFieldName": "twin.neighbor_2"
            }
          ],
          "nodeIdFieldName": "dt.smartscape.neighbor_2",
          "nodeType": "CUSTOM_CELL"
        }
      },
      {
        "description": "Neighbour cell 3 (id only)",
        "enabled": true,
        "id": "gy_twin_neighbor_3",
        "type": "smartscapeNode",
        "matcher": "matchesValue(twin.kind, \"cell\") and isNotNull(twin.neighbor_3)",
        "smartscapeNode": {
          "extractNode": false,
          "idComponents": [
            {
              "idComponent": "network",
              "referencedFieldName": "twin.network"
            },
            {
              "idComponent": "cell",
              "referencedFieldName": "twin.neighbor_3"
            }
          ],
          "nodeIdFieldName": "dt.smartscape.neighbor_3",
          "nodeType": "CUSTOM_CELL"
        }
      },
      {
        "description": "Agent changes: tag the cell they touched",
        "enabled": true,
        "id": "gy_twin_change_tower",
        "type": "smartscapeNode",
        "matcher": "(matchesValue(twin.kind, \"change\") or matchesValue(twin.kind, \"event\")) and isNotNull(twin.cell) and twin.cell != \"\"",
        "smartscapeNode": {
          "extractNode": false,
          "idComponents": [
            {
              "idComponent": "network",
              "referencedFieldName": "twin.network"
            },
            {
              "idComponent": "cell",
              "referencedFieldName": "twin.cell"
            }
          ],
          "nodeIdFieldName": "dt.smartscape_source.id",
          "nodeType": "CUSTOM_CELL"
        }
      }
    ]
  },
  "davis": {
    "processors": []
  }
}
