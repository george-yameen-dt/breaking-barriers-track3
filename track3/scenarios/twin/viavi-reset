#!/usr/bin/env bash
# Put the Viavi demo scenarios back to the baseline (40 dBm, S3 power failure at 180 s), on the team04 EC2
# (deploy-ec2.sh installs it as ~/team04-track3/viavi-reset). See reset.py.
#
#   ssh hackathon-ec2 ~/team04-track3/viavi-reset [--check] [--verify]
#
# Needs VIAVI_RSG_URL in ~/.config/team04/dt.env (mode 600), as viavi-run does.
set -euo pipefail
ROOT="${TEAM04_HOME:-$HOME/team04-track3}"
ENV_FILE="${TEAM04_ENV:-$HOME/.config/team04/dt.env}"
set -a
# shellcheck disable=SC1090
. "$ENV_FILE"
set +a
: "${VIAVI_RSG_URL:?is not set in $ENV_FILE}"
cd "$ROOT/track3"
exec "$ROOT/.venv/bin/python" -u scenarios/twin/reset.py "$@"
