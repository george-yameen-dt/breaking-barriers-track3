{
 "mcp": {
  "lambda": {
   "lambdaArn": "arn:aws:lambda:us-east-2:279760855394:function:team04-track3-tools",
   "toolSchema": {
    "inlinePayload": [
     {
      "name": "rollback_model",
      "description": "Switch the cell network's radio model back to an earlier version. Changes the network.",
      "inputSchema": {
       "type": "object",
       "properties": {
        "to": {
         "type": "string",
         "description": "model version, v1"
        },
        "run_id": {
         "type": "string",
         "description": "the Track 3 run id"
        }
       },
       "required": [
        "to"
       ]
      }
     },
     {
      "name": "restart_all_towers",
      "description": "Restart every tower in the cell network at once. Network-wide outage while towers reboot.",
      "inputSchema": {
       "type": "object",
       "properties": {
        "run_id": {
         "type": "string",
         "description": "the Track 3 run id"
        }
       },
       "required": []
      }
     }
    ]
   }
  }
 }
}